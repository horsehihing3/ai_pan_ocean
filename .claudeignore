# =============================================
# .claudeignore — 팬오션 안전보건 포털
# Claude Code 토큰 절약을 위해 불필요한 파일 제외
# =============================================

# --- Frontend 빌드 산출물 ---
frontend/dist/
frontend/node_modules/
frontend/.vite/
frontend/coverage/
frontend/stats.html

# --- Backend 빌드 산출물 ---
backend/node_modules/
backend/dist/
backend/build/

# --- Prisma 생성 파일 (schema.prisma는 읽어야 하므로 제외 안 함) ---
backend/node_modules/.prisma/
backend/src/generated/
backend/prisma/migrations/

# --- 로그 ---
logs/
*.log
backend/logs/

# --- 업로드 / 임시 파일 ---
uploads/
backend/uploads/
tmp/
*.tmp

# --- 환경변수 / 시크릿 ---
.env
.env.*
*.pem
*.key
*.p12
*.cert

# --- 테스트 픽스처 / 목 데이터 ---
backend/tests/fixtures/
frontend/src/__mocks__/
test-results/
coverage/

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# --- Git ---
.git/

# --- DB 덤프 ---
*.sql.bak
database/dump/

# --- 기획 원본 바이너리 (용량 큼) ---
*.pptx
*.xlsx
docs/raw/

# --- 아카이브 (최신 컨텍스트만 필요) ---
docs/ARCHIVE.md
